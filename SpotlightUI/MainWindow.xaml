<Window x:Class="SpotlightUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotlight" Width="680" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- Margin de 25px permite umbrei (DropShadow) să se vadă fără să fie tăiată -->
    <Border Margin="25" Background="#F21E1E1E" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <!-- Bara de căutare -->
            <Grid Height="58" Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Iconița Lupă -->
                <TextBlock Text="&#x1F50D;" FontSize="20" Foreground="#8E8E93" 
                           VerticalAlignment="Center" Margin="0,0,14,0"/>

                <!-- Placeholder Text (vizibil doar când nu e scris nimic) -->
                <TextBlock x:Name="PlaceholderText" Grid.Column="1" Text="Spotlight Search" 
                           FontSize="22" Foreground="#636366" VerticalAlignment="Center" 
                           IsHitTestVisible="False"/>

                <!-- Input-ul propriu-zis -->
                <TextBox x:Name="SearchBox" Grid.Column="1"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#FFFFFF" CaretBrush="#0A84FF"
                         FontSize="22" VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged"/>
            </Grid>

            <!-- Linie separatoare (apare doar când avem rezultate) -->
            <Border x:Name="SeparatorLine" Height="1" Background="#2C2C2E" Visibility="Collapsed"/>

            <!-- Lista de rezultate -->
            <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                     Visibility="Collapsed" Margin="8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ResultsList_MouseDoubleClick">
                
                <!-- Stilizăm itemele ca în macOS (Highlight albastru cu colțuri rotunjite) -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Setter.Property="Padding" Value="10,8"/>
                        <Setter Setter.Property="Margin" Value="0,1"/>
                        <Setter Setter.Property="Background" Value="Transparent"/>
                        <Setter Setter.Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" 
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#0A84FF"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#2C2C2E"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <!-- Template-ul unui rând din rezultate -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Badge simplu pentru tipul fișierului -->
                            <Border Background="#3A3A3C" CornerRadius="6" Width="28" Height="28" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayExt}" Foreground="#EBEBF5" FontSize="10" 
                                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Numele și Calea completă -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Path}" Foreground="#98989D" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="↵" Foreground="#8E8E93" FontSize="14" 
                                       VerticalAlignment="Center" Margin="10,0,4,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</Window>
