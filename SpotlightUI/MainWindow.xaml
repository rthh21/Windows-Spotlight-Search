<Window x:Class="SpotlightUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotlight" Width="640" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- macOS Frosted Glass Context Menu -->
        <ContextMenu x:Key="ResultItemContextMenu" Background="#EE14161D" Foreground="#FFFFFF" BorderBrush="#45FFFFFF">
            <MenuItem Header="Open File Location" Click="MenuOpenLocation_Click"/>
            <MenuItem Header="Copy Full Path" Click="MenuCopyPath_Click"/>
        </ContextMenu>

        <!-- Smooth instant style for action buttons (Search / Clear / Close) -->
        <Style x:Key="LiquidCircleButton" TargetType="Button">
            <Setter Property="Background" Value="#00FFFFFF"/>
            <Setter Property="Foreground" Value="#D8DDE6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="#00FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar Nativ / Minimalist macOS 27 & Windows 11 Fluent -->
        <Style x:Key="NativeScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="#38FFFFFF"
                                CornerRadius="2.5"
                                HorizontalAlignment="Right"
                                Width="5"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#70FFFFFF"/>
                                <Setter TargetName="ThumbBorder" Property="Width" Value="6"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#A0FFFFFF"/>
                                <Setter TargetName="ThumbBorder" Property="Width" Value="6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Width" Value="7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource NativeScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Animație de clipire fluidă (macOS Spotlight Caret Blink) -->
        <Storyboard x:Key="CaretBlinkStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="CaretElement"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0" Duration="0:0:0.53">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Capsulă macOS 27: CornerRadius="36" (1:1 cu forma de pilulă din poză la înălțimea de 72px) -->
    <Border x:Name="RootGlassBorder" Margin="0" CornerRadius="36" BorderThickness="1.2">

    <!-- Gradient vertical 1:1 cu poza macOS 27: negru intens sus -> sticlă lăptoasă/argintie jos -->
    <Border.Background>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#F6040508" Offset="0.0"/>
            <GradientStop Color="#EB10141B" Offset="0.28"/>
            <GradientStop Color="#DB2D343E" Offset="0.58"/>
            <GradientStop Color="#CC646C77" Offset="0.84"/>
            <GradientStop Color="#C49299A3" Offset="1.0"/>
        </LinearGradientBrush>
    </Border.Background>

    <!-- Contur Specular (Rim Light): discret sus, strălucitor pe curbele laterale și la bază -->
    <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#22FFFFFF" Offset="0.0"/>
            <GradientStop Color="#38FFFFFF" Offset="0.45"/>
            <GradientStop Color="#88FFFFFF" Offset="0.88"/>
            <GradientStop Color="#B5FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>
    </Border.BorderBrush>

    <Grid>
        <!-- STREAMING_CHUNK:Adding optical glass refraction and ambient highlights... -->
        <!-- Refracție optică rece subtilă în jumătatea stângă-mijloc (ca în poza cu munții pe fundal) -->
        <Ellipse Width="340" Height="64" HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="95,4,0,0" IsHitTestVisible="False" Opacity="0.16">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#5882B8" Offset="0.0"/>
                    <GradientStop Color="#005882B8" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="35"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Reflexie de bază (Bottom Inner Rim Glow) specifică macOS 27 -->
        <Border CornerRadius="35" IsHitTestVisible="False" VerticalAlignment="Bottom" Height="34">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#18FFFFFF" Offset="0.65"/>
                    <GradientStop Color="#36FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- STREAMING_CHUNK:Building the Search or Ask input bar and glowing caret... -->
        <!-- Main Content (Search & Results) -->
        <StackPanel x:Name="MainContainer">
            <!-- Capsule search bar (Height="72" for exact macOS proportions) -->
            <Grid Height="72" Margin="28,0,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Păstrat invizibil pentru compatibilitate 100% cu MainWindow.xaml.cs -->
                <Path x:Name="SearchIcon" Grid.Column="0" Width="0" Height="0" Opacity="0" IsHitTestVisible="False"
                      Data="M 0,0" Stroke="#FFFFFF"/>

                <!-- Cursorul luminos vertical din UI (urmează textul și pâlpâie) -->
                <Grid x:Name="CustomCaret" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Width="14" Height="36" Margin="-7,0,0,0" IsHitTestVisible="False">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="CaretTranslate" X="0" Y="0"/>
                    </Grid.RenderTransform>

                    <Grid x:Name="CaretElement">
                        <!-- Halo cald/alb în jurul cursorului (stil macOS 27 Spotlight) -->
                        <Border x:Name="CaretGlowAura" Width="8" Height="28" CornerRadius="4" Background="#FFF5D6" Opacity="0.80">
                            <Border.Effect>
                                <BlurEffect Radius="8"/>
                            </Border.Effect>
                        </Border>

                        <!-- Nucleul alb intens al cursorului vertical -->
                        <Border Width="2.8" Height="26" CornerRadius="1.4" Background="#FFFFFF">
                            <Border.Effect>
                                <DropShadowEffect Color="#FFE8B8" BlurRadius="6" ShadowDepth="0" Opacity="0.95"/>
                            </Border.Effect>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Placeholder Text "Search or Ask" 1:1 cu imaginea -->
                <TextBlock x:Name="PlaceholderText" Grid.Column="1" Text="Search or Ask"
                           FontFamily="Segoe UI Variable Display, SF Pro Display, Segoe UI"
                           FontSize="24" FontWeight="Regular" Foreground="#CFD5DF"
                           VerticalAlignment="Center" Margin="2,0,0,1"
                           IsHitTestVisible="False"/>

                <!-- Input-ul propriu-zis (cursorul nativ este invizibil via CaretBrush="Transparent") -->
                <TextBox x:Name="SearchBox" Grid.Column="1"
                         Background="Transparent" BorderThickness="0"
                         FontFamily="Segoe UI Variable Display, SF Pro Display, Segoe UI"
                         Foreground="#FFFFFF" CaretBrush="Transparent"
                         SelectionBrush="#550A84FF"
                         FontSize="24" FontWeight="Regular" VerticalContentAlignment="Center"
                         Margin="0,0,0,1"
                         TextChanged="SearchBox_TextChanged"
                         SelectionChanged="SearchBox_SelectionChanged"
                         GotFocus="SearchBox_GotFocus"
                         LostFocus="SearchBox_LostFocus"
                         PreviewMouseDown="SearchBox_PreviewMouseDown"/>

                <!-- Buton Clear vectorial (apare doar când scrii) -->
                <Button x:Name="ClearButton" Grid.Column="2" Width="30" Height="30"
                        Style="{StaticResource LiquidCircleButton}"
                        Visibility="Collapsed" Click="ClearButton_Click"
                        VerticalAlignment="Center" Margin="8,0,4,0">
                    <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="#D8DDE6" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- Right Search button (executes search on click) -->
                <Button x:Name="SettingsButton" Grid.Column="3" Width="38" Height="38"
                        Style="{StaticResource LiquidCircleButton}"
                        ToolTip="Search"
                        Click="SettingsButton_Click" VerticalAlignment="Center" Margin="2,0,0,0">
                    <Canvas Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Cercul lupei -->
                        <Ellipse Canvas.Left="2.5" Canvas.Top="2.5" Width="10.5" Height="10.5"
                                 Stroke="#DCE1EA" StrokeThickness="1.9"/>
                        <!-- Mânerul lupei -->
                        <Path Data="M 10.4,10.4 L 16.5,16.5"
                              Stroke="#DCE1EA" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Button>
            </Grid>

            <!-- STREAMING_CHUNK:Styling the expandable results list and liquid items... -->
            <!-- Linie separatoare sticloasă când apar rezultatele -->
            <Border x:Name="SeparatorLine" Height="1" Margin="26,0" Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#45FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Lista de rezultate -->
            <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                     Visibility="Collapsed" Margin="14,8,14,14" MaxHeight="460"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     VirtualizingStackPanel.ScrollUnit="Pixel"
                     Padding="0,0,4,0"
                     MouseDoubleClick="ResultsList_MouseDoubleClick">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="Margin" Value="2,2"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="ContextMenu" Value="{StaticResource ResultItemContextMenu}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="#00FFFFFF"
                                            BorderBrush="#00FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="18"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#25FFFFFF"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#35FFFFFF"/>
                                        </MultiTrigger>

                                        <!-- Selecție fluidă și instantă în stil macOS 27 Frosted Pill -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#44FFFFFF"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#75FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Width="34" Height="34" VerticalAlignment="Center">
                                <!-- Fallback Badge când nu este disponibilă o iconiță de aplicație (calculator / comenzi sistem) -->
                                <Border Background="{Binding BadgeBackgroundBrush}" CornerRadius="10" Width="34" Height="34"
                                        BorderBrush="#40FFFFFF" BorderThickness="1"
                                        Visibility="{Binding IconVisibilityFallback}">
                                    <TextBlock Text="{Binding BadgeIcon}" Foreground="White" FontSize="11"
                                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Iconiță reală nativă de înaltă rezoluție extrasă din aplicație / fișier -->
                                <Image Source="{Binding Icon}" Width="32" Height="32"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       SnapsToDevicePixels="True"
                                       Visibility="{Binding IconVisibilityReal}"/>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="14.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="460"/>
                                    <Border Visibility="{Binding TopHitVisibility}" Background="#35FFFFFF" BorderBrush="#65FFFFFF"
                                            BorderThickness="1" CornerRadius="8" Padding="7,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="TOP HIT" Foreground="#FFFFFF" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                    <Border Visibility="{Binding CategoryBadgeVisibility}" Background="{Binding CategoryBadgeBrush}"
                                            BorderBrush="{Binding CategoryBadgeBorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="6,1.5" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CategoryBadgeText}" Foreground="#FFFFFF" FontSize="8.5" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Subtitle}" Foreground="#DCE1EB" FontSize="11.5" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- STREAMING_CHUNK:Rendering the Settings & Ask Siri/Spotlight overlay... -->
        <!-- Settings / Spotlight Shortcuts Overlay (:settings) -->
        <Border x:Name="SettingsOverlay" Visibility="Collapsed" CornerRadius="36" Padding="28,22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#F8080A0F" Offset="0.0"/>
                    <GradientStop Color="#F2242A34" Offset="0.65"/>
                    <GradientStop Color="#EB555D69" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#28FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="11" Width="32" Height="32" Margin="0,0,12,0">
                            <Canvas Width="20" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Canvas.Left="6.5" Canvas.Top="2" Width="7" Height="12.5" RadiusX="3.5" RadiusY="3.5"
                                           Stroke="#FFFFFF" StrokeThickness="1.8"/>
                                <Path Data="M 3,10.5 L 3,11.5 A 7,7 0 0 0 17,11.5 L 17,10.5"
                                      Stroke="#FFFFFF" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path Data="M 10,18.5 L 10,22 M 6.2,22 L 13.8,22"
                                      Stroke="#FFFFFF" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Border>
                        <TextBlock Text="Search or Ask — macOS 27 Spotlight" FontSize="17" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Width="30" Height="30" HorizontalAlignment="Right"
                            Style="{StaticResource LiquidCircleButton}" Click="CloseSettings_Click">
                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="#FFFFFF" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <Border Height="1" Margin="0,0,0,12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#45FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Calculator:" FontWeight="SemiBold" Foreground="#30D158" FontSize="12.5"/>
                    <TextBlock Grid.Column="1" Text="Type expressions directly: = 12.5 * 4, = 2^10, = (100+25)/5" Foreground="#F0F2F7" FontSize="12.5"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="System Commands:" FontWeight="SemiBold" Foreground="#FFD60A" FontSize="12.5"/>
                    <TextBlock Grid.Column="1" Text="Type &gt;lock, &gt;sleep, &gt;ip, &gt;cmd, &gt;wt or :settings" Foreground="#F0F2F7" FontSize="12.5"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Extension Filters:" FontWeight="SemiBold" Foreground="#64D2FF" FontSize="12.5"/>
                    <TextBlock Grid.Column="1" Text="e.g.: ext:pdf contract, ext:png screenshot" Foreground="#F0F2F7" FontSize="12.5"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Technology:" FontWeight="SemiBold" Foreground="#DF9EFF" FontSize="12.5"/>
                    <TextBlock Grid.Column="1" Text="Direct NTFS MFT scanning, Live USN Journal and persistent TCP Socket (&lt; 1ms)" Foreground="#F0F2F7" FontSize="12.5"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Shortcuts:" FontWeight="SemiBold" Foreground="#D8DDE6" FontSize="12.5"/>
                    <TextBlock Grid.Column="1" Text="Alt + Space (Toggle), Esc (Close), Return (Launch/Copy)" Foreground="#F0F2F7" FontSize="12.5"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Border>
</Window>
